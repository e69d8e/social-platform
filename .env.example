# ===========================================
# Social Platform 环境变量配置示例
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ===========================================

# MySQL / Redis / JWT 共用密码（必填）
PASSWORD=your_password_here

# DeepSeek AI (DeepSeek-V4-Flash) API Key（必填）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 前端静态资源与图片根目录（包含 index.html、assets 以及 imgs 图片子目录）
# 本地 IDEA 开发与全容器部署默认使用相对路径 ./html；配置 HTML_PATH 后，图片存储目录自动为 ${HTML_PATH}/imgs
HTML_PATH=./html

# 图片访问基础 URL
# ⚠️ 注意：若部署到其他服务器/局域网电脑，请务必将 127.0.0.1 替换为服务器实际 IP 或域名
# 例如：BASE_URL=http://192.168.1.100:8080/imgs 或 BASE_URL=http://your-domain.com/imgs
BASE_URL=http://127.0.0.1:8080/imgs

# 前端跨域允许来源（多个以逗号分隔）
CORS_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:8080,http://localhost:5173,http://localhost:8080

