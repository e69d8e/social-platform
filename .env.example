# ===========================================
# Social Platform 环境变量配置示例
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
# ===========================================

# MySQL / Redis / JWT 共用密码
PASSWORD=your_password_here

# DashScope AI (通义千问) API Key
DASH_SCOPE_API_KEY=your_dashscope_api_key_here

# Nginx 静态图片目录（上传图片存储路径）
IMAGE_PATH=/usr/local/nginx/html/imgs

# 图片访问基础 URL（可选，默认 http://127.0.0.1:8080/imgs）
# BASE_URL=http://your-domain.com/imgs

# Nginx 配置目录（包含 nginx.conf 和 conf.d/）
NGINX_DIR=/usr/local/nginx

# 跨域允许来源（可选，默认 http://127.0.0.1:5173 和 http://127.0.0.1:8080）
# CORS_ORIGIN=http://127.0.0.1:5173
