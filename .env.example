# ===========================================
# Social Platform 环境变量配置示例
# 复制此文件为 .env 并填入实际值：cp .env.example .env
# ===========================================

# MySQL / Redis / JWT 共用密码（必填）
# ⚠️ 建议 16 位以上字母数字组合；勿含空格、$、引号等特殊字符（会破坏 compose 命令解析）
# ⚠️ MySQL 密码仅在数据卷首次初始化时写入：首次启动后修改 PASSWORD 需 `docker compose down -v` 重建（清空数据），详见 README FAQ Q11
PASSWORD=your_password_here

# AI 大模型（OpenAI 兼容协议接口）配置
# 支持接入 DeepSeek、OpenAI、通义千问、SiliconFlow、OneAPI 或 Ollama 等任意兼容 OpenAI 接口的大模型
# 必填项：模型 API Key（前往服务商开放平台申请，例如 DeepSeek: https://platform.deepseek.com/）
OPENAI_API_KEY=your_api_key_here

# 选填项：API 基础地址（默认：https://api.deepseek.com，支持配置第三方代理、中转或本地兼容服务）
OPENAI_BASE_URL=https://api.deepseek.com

# 选填项：模型名称（默认：deepseek-v4-flash，可根据中转服务商或需求配置，如 deepseek-chat、gpt-4o 等）
MODEL_NAME=deepseek-v4-flash

# 前端静态资源根目录（包含 index.html、assets；图片已改存 MinIO 对象存储，不再落盘本目录）
# 本地 IDEA 开发与全容器部署默认使用相对路径 ./html
HTML_PATH=./html

# MinIO 对象存储配置（图片上传/删除的存储后端）
# 本地开发用 docker compose 启动 sp-minio 后保持默认即可
MINIO_ROOT_USER=minioadmin
# 密码默认复用上方的 PASSWORD；⚠️ MinIO 要求密码至少 8 位，
# 若 PASSWORD 不足 8 位必须单独设置 MINIO_ROOT_PASSWORD（随机长密码即可）
# MINIO_ROOT_PASSWORD=your_minio_password_here
# MINIO_ENDPOINT=http://127.0.0.1:9000
# MINIO_BUCKET=social-platform
# 文件自动清理（可选）：默认开启，宽限期 24 小时内的对象不清理
# MINIO_CLEANUP_ENABLED=true
# MINIO_CLEANUP_GRACE_HOURS=24

# 图片访问基础 URL（Nginx 将 /imgs 代理到 MinIO 桶直出，URL 结构不变）
# ⚠️ 注意：若部署到其他服务器/局域网电脑，请务必将 127.0.0.1 替换为服务器实际 IP 或域名
# 例如：IMG_BASE_URL=http://192.168.1.100:8080/imgs 或 IMG_BASE_URL=http://your-domain.com/imgs
IMG_BASE_URL=http://127.0.0.1:8080/imgs

# 前端跨域允许来源（多个以逗号分隔）
CORS_ORIGIN=http://127.0.0.1:5173,http://127.0.0.1:8080,http://localhost:5173,http://localhost:8080

